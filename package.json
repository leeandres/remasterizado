{
  "name": "masterai-pro",
  "version": "1.0.0",
  "private": true,
  "description": "MasterAI Pro \u2014 AI-assisted audio mastering studio in the browser",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "electron:dev": "electron .",
    "electron:build": "npm run build && node scripts/copy-standalone.js && electron-builder",
    "electron:build:mac": "npm run build && node scripts/copy-standalone.js && electron-builder --mac",
    "electron:build:win": "npm run build && node scripts/copy-standalone.js && electron-builder --win"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@wasm-audio-decoders/flac": "0.2.11",
    "chart.js": "4.6.1",
    "idb": "8.0.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wavesurfer.js": "7.12.12",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.masterai.pro",
    "productName": "MasterAI Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}